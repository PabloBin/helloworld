pipeline {
    agent any
    
    options { skipDefaultCheckout() }
    
    stages {
        stage('Get Code') {
            steps {
                // Limpiar workspace del agente Get Code
                deleteDir()
                
                //Obtener código de repositorio
                checkout scm   // respeta la rama configurada en el job
                bat 'git rev-parse --abbrev-ref HEAD'
                bat 'git log -1 --oneline'
                
                //Guarda el código
                stash name: 'source', includes: '**/*'
            }
        }
        
        stage('Tests') {
            parallel {
                stage('Unit') {
                    agent {label 'Agente_Windows_2'}
                    steps {
                        // 1) Limpiar workspace del agente UNIT
                        deleteDir()
                            
                        unstash name:'source'
                        
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                             // 2) Ejecutar las pruebas UNIT
                            bat '''
                                set PYTHONPATH=%WORKSPACE%
                                "C:\\Program Files\\Python312\\python.exe" -m pytest -o junit_suite_name=unit --junitxml=result-unit.xml test\\unit
                            '''
                            
                            // 3) Guardar el XML de resultados
                            stash name: 'unit-test', includes: 'result-unit.xml'
                        }
                    }
                }
                stage('Rest') {
                    agent { label 'Agente_Windows_1' }

                    steps {
                        // Limpias workspace al entrar si quieres
                        deleteDir()
                        unstash name: 'source'

                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                @echo off
                                rem === 1) Arrancar Flask y WireMock en background ===
                                set FLASK_APP=app\\api.py

                                start "" /B "C:\\Program Files\\Python312\\python.exe" -m flask run
                                start "" /B java -jar "D:\\MIS DOCUMENTOS\\_CURSOS\\UNIR\\UTILS\\WIREMOCK\\wiremock-standalone-3.13.2.jar" --port 9090 --root-dir test\\wiremock

                                rem === 2) Esperar a que Flask (5000) y WireMock (9090) estén levantados ===
                                setlocal enabledelayedexpansion
                                set /a retries=0
                                :wait_loop

                                curl -s http://localhost:5000/  >NUL 2>&1 || (
                                    set /a retries+=1
                                    if !retries! GEQ 40 (
                                        echo Flask no responde tras 40 intentos
                                        goto :cleanup_and_fail
                                    )
                                    timeout /t 1 >NUL
                                    goto wait_loop
                                )

                                curl -s http://localhost:9090/__admin/ >NUL 2>&1 || (
                                    set /a retries+=1
                                    if !retries! GEQ 40 (
                                        echo WireMock no responde tras 40 intentos
                                        goto :cleanup_and_fail
                                    )
                                    timeout /t 1 >NUL
                                    goto wait_loop
                                )

                                rem === 3) Ejecutar tests REST ===
                                "C:\\Program Files\\Python312\\python.exe" -m pytest -o junit_suite_name=rest --junitxml=result-rest.xml test\\rest
                                set TEST_ERROR=%ERRORLEVEL%

                                rem === 4) Limpieza de procesos SIEMPRE ===
                                :cleanup
                                rem OJO: esto matará TODOS los python/java del agente
                                rem En un agente dedicado para esto es aceptable.
                                for /f "tokens=2" %%P in ('tasklist ^| find "python.exe"') do taskkill /F /PID %%P >NUL 2>&1
                                for /f "tokens=2" %%P in ('tasklist ^| find "java.exe"')   do taskkill /F /PID %%P >NUL 2>&1

                                exit /b %TEST_ERROR%

                                :cleanup_and_fail
                                goto cleanup
                            '''
                        }

                        stash name: 'rest-test', includes: 'result-rest.xml', allowEmpty: true
                    }
                }
            }
        }
        
        stage('Results') {
            steps {
                // 1) Limpiar workspace del agente RESULTS
                deleteDir()
                
                // 2) obtenemos unit-test
                unstash name:'unit-test'
                
                // 3) rest-test puede no existir si la stage Rest ha fallado
                script {
                    try {
                        unstash name:'rest-test'
                    } catch (e) {
                        echo "No hay stash 'rest-test' (las pruebas REST no se ejecutaron o fallaron antes del stash)."
                    }
                }
                
                // 4) 
                archiveArtifacts artifacts: 'result*.xml', fingerprint: true
                junit 'result*.xml'
            }
        }
    }
}