pipeline {
    agent any
    
    options { skipDefaultCheckout() }
    
    stages {
        stage('Get Code') {
            steps {
                // Limpiar workspace del agente Get Code
                deleteDir()
                
                //Obtener código de repositorio
                checkout scm   // respeta la rama configurada en el job
                bat 'git rev-parse --abbrev-ref HEAD'
                bat 'git log -1 --oneline'
                
                //Guarda el código
                stash name: 'source', includes: '**/*'
            }
        }
        
        stage('Static'){
            steps{
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat'''
                        flake8 --exit-zero --format=pylint app >flake8.out
                    '''
                }
                
                recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')], qualityGates: [[threshold: 8, type: 'TOTAL', unstable: true], [threshold: 10, type: 'TOTAL', unstable: false]]
            }
        }
        
        stage('Tests') {
            parallel {
                stage('Unit') {
                    agent {label 'Agente_Windows_2'}
                    steps {
                        // 1) Limpiar workspace del agente UNIT
                        deleteDir()
                            
                        unstash name:'source'
                        
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                             // 2) Ejecutar las pruebas UNIT
                            bat '''
                                set PYTHONPATH=%WORKSPACE%
                                "C:\\Program Files\\Python312\\python.exe" -m pytest -o junit_suite_name=unit --junitxml=result-unit.xml test\\unit
                            '''
                            
                            // 3) Guardar el XML de resultados
                            stash name: 'unit-test', includes: 'result-unit.xml'
                        }
                    }
                }
                stage('Service') {
                    agent {label 'Agente_Windows_1'}
                    steps {
                        // 1) Limpiar workspace del agente SERVICE
                        deleteDir()
                            
                        unstash name:'source'
                        
                        // 2) Arrancar Flask y WireMock en background
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                set FLASK_APP=app\\api.py
                                start "FLASK_JENKINS" /MIN "C:\\Program Files\\Python312\\python.exe" -m flask run
                                
                                start "WIREMOCK_JENKINS" /MIN java -jar "D:\\MIS DOCUMENTOS\\_CURSOS\\UNIR\\UTILS\\WIREMOCK\\wiremock-standalone-3.13.2.jar" --port 9090 --root-dir test\\wiremock
                            '''
                        }
                        
                        // 3) Esperar hasta que ambos servicios respondan
                        timeout(time: 1, unit: 'MINUTES') {   // máx 1 minuto
                            script {
                                waitUntil {
                                    def status = bat(
                                        returnStatus: true,
                                        script: '''
                                            rem Comprobar Flask (puerto 5000)
                                            curl -s http://localhost:5000/ >NUL 2>&1 || exit /b 1
                                            
                                            rem Comprobar WireMock (puerto 9090)
                                            curl -s http://localhost:9090/__admin/ >NUL 2>&1 || exit /b 1
                                        '''
                                    )
                                    // status == 0 => los dos han respondido, salimos del waitUntil
                                    return (status == 0)
                                }
                            }
                        }
                        
                        // 4) Ejecutar las pruebas REST
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                set PYTHONPATH=%WORKSPACE%
                                "C:\\Program Files\\Python312\\python.exe" -m pytest -o junit_suite_name=rest --junitxml=result-rest.xml test\\rest
                            '''
                            
                            // 2) Intentar guardar el resultado REST, aunque esté vacío (allowEmpty evita que falle si no hay result-rest.xml)
                            stash name: 'rest-test', includes: 'result-rest.xml', allowEmpty: true
                        }
                    }
                    
                    post {
                        always {
                            // 1) Cerrar siempre los servicios (Flask y WireMock)
                            bat '''
                                rem Matar ventana/procesos de Flask
                                taskkill /F /FI "WINDOWTITLE eq FLASK_JENKINS" /T >NUL 2>&1 || echo Flask ya parado
                                
                                rem Matar ventana/procesos de WireMock
                                taskkill /F /FI "WINDOWTITLE eq WIREMOCK_JENKINS" /T >NUL 2>&1 || echo WireMock ya parado
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Cobertura'){
            steps{
                // 1) Limpiar workspace del agente COBERTURA
                deleteDir()
                            
                unstash name:'source'
                
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat'''
                        set PYTHONPATH=%WORKSPACE%
                        "C:\\Program Files\\Python312\\python.exe" -m coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest test\\unit
                        "C:\\Program Files\\Python312\\python.exe" -m coverage xml -o coverage.xml
                    '''
                }
                
                recordCoverage qualityGates: [[criticality: 'ERROR', integerThreshold: 85, metric: 'LINE', threshold: 85.0], [integerThreshold: 95, metric: 'LINE', threshold: 95.0], [criticality: 'ERROR', integerThreshold: 80, metric: 'BRANCH', threshold: 80.0], [integerThreshold: 90, metric: 'BRANCH', threshold: 90.0]], tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']]
            }
        }
        
        stage('Security'){
            steps{
                
                bat'''
                    bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                '''

                recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')], qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true], [threshold: 4, type: 'TOTAL', unstable: false]]
            }
        }
        
        stage('Performance'){
            agent { label 'Agente_Windows_1' }
            steps{
                // 1) Limpiar workspace del agente PERFORMANCE
                deleteDir()
                
                unstash name:'source'
                
                // 2) Arrancar Flask y WireMock en background
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat '''
                        set FLASK_APP=app\\api.py
                        start "FLASK_JENKINS" /MIN "C:\\Program Files\\Python312\\python.exe" -m flask run
                    '''
                }
                
                // 3) Esperar hasta el servicio de Flask respondan
                timeout(time: 1, unit: 'MINUTES') {   // máx 1 minuto
                    script {
                        waitUntil {
                            def status = bat(
                                returnStatus: true,
                                script: '''
                                    rem Comprobar Flask (puerto 5000)
                                    curl -s http://localhost:5000/ >NUL 2>&1 || exit /b 1
                                '''
                            )
                            // status == 0 => ha respondido, salimos del waitUntil
                            return (status == 0)
                        }
                    }
                }
                
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat'''
                        "D:\\MIS DOCUMENTOS\\_CURSOS\\UNIR\\UTILS\\JMETER\\apache-jmeter-5.5\\bin\\jmeter" -n -t test\\jmeter\\flask.jmx -l flask.jtl
                    '''
                }
                
                perfReport sourceDataFiles: 'flask.jtl'
            }
            
            post {
                always {
                    // 1) Cerrar siempre el servicio (Flask)
                    bat '''
                        rem Matar ventana/procesos de Flask
                        taskkill /F /FI "WINDOWTITLE eq FLASK_JENKINS" /T >NUL 2>&1 || echo Flask ya parado
                    '''
                }
            }
        }
    }
}