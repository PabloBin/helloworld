pipeline {
   agent {label 'Agente_Principal'}

    options {
        skipDefaultCheckout()
    }

    environment {
        PYTHON = 'C:\\Program Files\\Python312\\python.exe'
        WIREMOCK = 'D:\\MIS DOCUMENTOS\\_CURSOS\\UNIR\\UTILS\\WIREMOCK\\wiremock-standalone-3.13.2.jar'
        JMETER = 'D:\\MIS DOCUMENTOS\\_CURSOS\\UNIR\\UTILS\\JMETER\\apache-jmeter-5.5\\bin\\jmeter'
        FLASK_APP_FILE = 'app\\api.py'
    }

    stages {

        // ------------------------------------------------------------
        // 1) GET CODE
        // ------------------------------------------------------------
        stage('Get Code') {
            steps {
                deleteDir()
                git 'https://github.com/PabloBin/helloworld.git'
            }
        }

        // ------------------------------------------------------------
        // 4) STATIC - FLAKE8
        // ------------------------------------------------------------
        stage('Static - Flake8') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat """
                        flake8 --exit-zero --format=pylint app 1> flake8.out
                    """
                    recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')], qualityGates: [[threshold: 8, type: 'TOTAL', unstable: true], [threshold: 10, type: 'TOTAL', unstable: false]]
                }
            }
        }

        // ------------------------------------------------------------
        // 5) SECURITY - BANDIT
        // ------------------------------------------------------------
        stage('Security - Bandit') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat """
                        bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                    """
                    recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')], qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true], [threshold: 4, type: 'TOTAL', unstable: false]]
                }
            }
        }

        // ------------------------------------------------------------
        // 6) UNIT TESTS
        // ------------------------------------------------------------
        
        stage('Unit Tests') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat """
                        set PYTHONPATH=%WORKSPACE%
                        if exist .coverage del /F /Q .coverage
                        "${env.PYTHON}" -m coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest -o junit_suite_name=unit --junitxml=result-unit.xml test\\unit
                    """
                    junit "result-unit.xml"
                }
            }
        }

        // ------------------------------------------------------------
        // 7) REST TEST
        // ------------------------------------------------------------
        stage('Rest Test') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat """
                        set FLASK_APP=app\\api.py
                        start "FLASK_JENKINS" /MIN "${env.PYTHON}" -m flask run
                        
                        start "WIREMOCK_JENKINS" /MIN java -jar "${env.WIREMOCK}" --port 9090 --root-dir test\\wiremock
                    """
                }
                
                timeout(time: 1, unit: 'MINUTES') {   // máx 1 minuto
                    script {
                        waitUntil {
                            def status = bat(
                                returnStatus: true,
                                script: '''
                                    rem Comprobar Flask (puerto 5000)
                                    curl -s http://localhost:5000/ >NUL 2>&1 || exit /b 1
                                    
                                    rem Comprobar WireMock (puerto 9090)
                                    curl -s http://localhost:9090/__admin/ >NUL 2>&1 || exit /b 1
                                '''
                            )
                            // status == 0 => los dos han respondido, salimos del waitUntil
                            return (status == 0)
                        }
                    }
                }
                
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat """
                        set PYTHONPATH=%WORKSPACE%
                        "${env.PYTHON}" -m pytest -o junit_suite_name=rest --junitxml=result-rest.xml test\\rest
                    """
                    junit "result-rest.xml" 
               }
               
               catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat '''
                        rem Matar ventana/procesos de Flask
                        taskkill /F /FI "WINDOWTITLE eq FLASK_JENKINS" /T >NUL 2>&1 || echo Flask ya parado
                        
                        rem Matar ventana/procesos de WireMock
                        taskkill /F /FI "WINDOWTITLE eq WIREMOCK_JENKINS" /T >NUL 2>&1 || echo WireMock ya parado
                    '''
               }
            }
        }

        // ------------------------------------------------------------
        // 11) COVERAGE
        // ------------------------------------------------------------
        stage('Coverage') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat """
                        set PYTHONPATH=%WORKSPACE%
                        rem "${env.PYTHON}" -m coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest test\\unit
                        "${env.PYTHON}" -m coverage xml -o coverage.xml
                    """
                    recordCoverage qualityGates: [[criticality: 'ERROR', integerThreshold: 85, metric: 'LINE', threshold: 85.0], [integerThreshold: 95, metric: 'LINE', threshold: 95.0], [criticality: 'ERROR', integerThreshold: 80, metric: 'BRANCH', threshold: 80.0], [integerThreshold: 90, metric: 'BRANCH', threshold: 90.0]], tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']]
                }
            }
        }

        // ------------------------------------------------------------
        // 12) PERFORMANCE
        // ------------------------------------------------------------
        stage('Performance') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat """
                        set FLASK_APP=app\\api.py
                        start "FLASK_JENKINS_PERF" /MIN "${env.PYTHON}" -m flask run
                    """
                }
                
                timeout(time: 1, unit: 'MINUTES') {   // máx 1 minuto
                    script {
                        waitUntil {
                            def status = bat(
                                returnStatus: true,
                                script: '''
                                    rem Comprobar Flask (puerto 5000)
                                    curl -s http://localhost:5000/ >NUL 2>&1 || exit /b 1
                                '''
                            )
                            // status == 0 => ha respondido, salimos del waitUntil
                            return (status == 0)
                        }
                    }
                }
                
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    // MUY IMPORTANTE: borra el JTL antes para evitar el error de "Could not delete results file"
                    bat """
                        if exist "flask.jtl" del /F /Q "flask.jtl"
                        "${env.JMETER}" -n -t test\\jmeter\\flask.jmx -l "flask.jtl"
                    """
                    // Plugin Performance
                    perfReport sourceDataFiles: "flask.jtl"
                }

                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat '''
                        taskkill /F /FI "WINDOWTITLE eq FLASK_JENKINS_PERF" /T >NUL 2>&1 || echo Flask ya parado
                    '''
                }
            }
        }
    }
}